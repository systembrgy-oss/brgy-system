# ==============================================================================
# BARANGAY INFORMATION MANAGEMENT SYSTEM (BIMS) - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your confidential API keys and credentials.
# Do NOT commit .env with real credentials to version control.

# --- 1. CORE DJANGO SETTINGS ---
SECRET_KEY=django-insecure-qec!c^k&aav)^@($j)(_o*&6w&epn%5(cr!bkfw6c)3-$3yiv9
DEBUG=True
ALLOWED_HOSTS=*

# --- 2. EMAIL (GMAIL SMTP NOTIFICATIONS) ---
# To test without sending real emails (prints to terminal console):
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# To send REAL emails to residents via Gmail SMTP:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Enter your Gmail address (e.g., barangay.sanroque.bims@gmail.com)
EMAIL_HOST_USER=

# Enter your 16-character Google App Password (NOT your personal Gmail password)
# How to get it: Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_HOST_PASSWORD=

# Display name / sender address seen by residents
DEFAULT_FROM_EMAIL=Barangay San Roque <notifications@barangaysanroque.gov.ph>

# --- 3. SMS GATEWAY INTEGRATION (OPTIONAL) ---
# For sending emergency broadcast SMS or reference status via Semaphore or PhilSMS
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=BIMS-ALERT

# --- 4. MAPS / GEOCODING (OPTIONAL) ---
# For purok boundary plotting and Google Maps GIS
GOOGLE_MAPS_API_KEY=
